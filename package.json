{
  "name": "findyou",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "check": "node node_modules/typescript/bin/tsc -b --pretty false",
    "test": "node node_modules/vitest/vitest.mjs run",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "tauri": "node scripts/tauri.mjs",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build --no-bundle",
    "desktop:package": "pnpm desktop:build && node scripts/package.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx,css}\" \"contracts/**/*.{ts,json}\" \"mock/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.{ts,js,json}\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx,css}\" \"contracts/**/*.{ts,json}\" \"mock/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"*.{ts,js,json}\"",
    "lint": "node node_modules/eslint/bin/eslint.js src contracts tests",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "antd": "^6.0.0",
    "echarts": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
