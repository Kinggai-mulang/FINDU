{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FINDU",
  "version": "0.7.6",
  "identifier": "com.findyou.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FINDU · GNSS 工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "backgroundColor": "#10141c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/engine/": "engine/",
      "../resources/product-tools/": "product-tools/",
      "../resources/product-runtime/": "product-runtime/"
    }
  }
}
